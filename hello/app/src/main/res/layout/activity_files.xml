<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000" android:fitsSystemWindows="true">
  <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
      android:background="#000000" app:title="文件列表" app:titleTextColor="#FFFFFF"
      app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"/>
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_upload" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_margin="16dp" android:text="上传文件" android:textColor="#000000"
      app:backgroundTint="#FFFFFF" app:cornerRadius="12dp"/>
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rv_files" android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="1" android:paddingHorizontal="16dp" android:clipToPadding="false"
      android:paddingBottom="16dp"/>
</LinearLayout>
